# =============================================================================
# Telegram AI Bot — example environment file
# Copy this file to `.env` and fill in your values, OR set these in your
# hosting provider's dashboard (Render, Koyeb, Fly.io, etc.).
# DO NOT COMMIT THE REAL .env FILE.
# =============================================================================

# --- Required -----------------------------------------------------------------

# 1) Get from @BotFather on Telegram
BOT_TOKEN=123456789:replace-with-your-token

# 2) Your numeric Telegram user ID (every received message will be forwarded here)
#    Get it from @userinfobot
OWNER_CHAT_ID=7878003028

# --- AI providers (at least Gemini is strongly recommended) -------------------

# Google AI Studio: https://aistudio.google.com/apikey  (free tier)
GEMINI_API_KEY=

# Optional: Hugging Face token for higher rate limits (https://huggingface.co/settings/tokens)
HF_API_TOKEN=

# --- Runtime ------------------------------------------------------------------

# polling (default, easiest) or webhook
MODE=polling

# Required only when MODE=webhook (e.g. https://your-app.onrender.com)
WEBHOOK_URL=
WEBHOOK_SECRET=

# Health-check port (Render assigns this automatically via $PORT)
PORT=8080

# Logging
LOG_LEVEL=INFO

# Limits
MAX_IMAGE_MB=20
RATE_LIMIT_PER_MINUTE=10
